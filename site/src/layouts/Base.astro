---
import "../styles/global.css";
// The Latin subset is what the hero is set in. Preloading it keeps the first paint from swapping fonts.
import geist from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import { ORIGIN, BASE, NAME, facts, description as siteDescription, graph } from "../lib";

interface Props {
  title: string;
  description?: string;
  path?: string;
  nodes?: object[];
  home?: boolean;
  noindex?: boolean;
}
const { title, description = siteDescription, path = "", nodes = [], home = false, noindex = false } = Astro.props;

const canonical = `${ORIGIN}${BASE}${path}`;
const mirror = (Astro.site?.hostname ?? "").endsWith("github.io");
const fullTitle = home ? `${NAME}: display brightness from the menu bar` : `${title} · ${NAME}`;
const og = `${ORIGIN}${BASE}og/home.png`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(mirror || noindex) && <meta name="robots" content="noindex" />}
    <link rel="alternate" type="text/markdown" href={`${BASE}index.md`} title="Markdown" />
    <link rel="alternate" type="application/atom+xml" href={`${BASE}feed.xml`} title={`${NAME} releases`} />
    <link rel="icon" href={`${BASE}favicon.ico`} sizes="32x32" />
    <link rel="icon" type="image/svg+xml" sizes="any" href={`${BASE}favicon.svg`} />
    <link rel="apple-touch-icon" href={`${BASE}apple-touch-icon.png`} />
    <link rel="manifest" href={`${BASE}manifest.webmanifest`} />
    <link rel="preload" href={geist} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#0d0e10" />
    <meta name="color-scheme" content="dark" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${NAME}: display brightness from the menu bar. ${facts.size.ours}, no network, no permissions.`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    {nodes.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(graph(...nodes))} />}
  </head>
  <body>
    <slot />
    <script>
      import "../scripts/webmcp";
    </script>
  </body>
</html>
