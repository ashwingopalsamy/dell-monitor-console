---
// The Display panel's three glyphs, copied from ModeGlyphs.swift: Control Center's own artwork, measured from a 2x
// screenshot, in points on an 18pt box centred on 0,0. Fills, except the sun's eight round-capped rays. The rays reach
// 9.2pt, just past the box, so the svg must not clip them.
interface Props {
  mode: "dark" | "night" | "tone";
  class?: string;
}
const { mode, class: cls } = Astro.props;
const rays = "M6.675 0h1.7M4.72 4.72l1.202 1.202M0 6.675v1.7M-4.72 4.72l-1.202 1.202M-6.675 0h-1.7M-4.72-4.72l-1.202-1.202M0-6.675v-1.7M4.72-4.72l1.202-1.202";
const fill = {
  // A disc split down the middle: solid on the left, a ring on the right, and a small disc at the centre the other way round.
  dark: "M0-8.55A8.55 8.55 0 0 0 0 8.55V3.3A3.3 3.3 0 0 1 0-3.3ZM0-8.55A8.55 8.55 0 0 1 0 8.55V6.9A6.9 6.9 0 0 0 0-6.9ZM0-3.3A3.3 3.3 0 0 1 0 3.3Z",
  // A ring, and a disc inside it set up and to the right, which leaves a crescent moon of background.
  night: "M4.325 0A4.325 4.325 0 1 1-4.325 0A4.325 4.325 0 1 1 4.325 0ZM2.775 0A2.775 2.775 0 1 0-2.775 0A2.775 2.775 0 1 0 2.775 0ZM3.6-1.25A2.3 2.3 0 1 1-1-1.25A2.3 2.3 0 1 1 3.6-1.25Z",
  // A disc cut into bars by horizontal gaps that narrow toward the bottom.
  tone: "M-1.901-3.885A4.325 4.325 0 0 1 1.901-3.885ZM-3.49-2.555H3.49A4.325 4.325 0 0 1 3.866-1.94H-3.866A4.325 4.325 0 0 1-3.49-2.555ZM-4.222-.94H4.222A4.325 4.325 0 0 1 4.324.115H-4.324A4.325 4.325 0 0 1-4.222-.94ZM-4.273.67H4.273A4.325 4.325 0 0 1 3.741 2.17H-3.741A4.325 4.325 0 0 1-4.273.67ZM3.486 2.56A4.325 4.325 0 0 1-3.486 2.56Z",
};
---
<svg class:list={["mg", cls]} viewBox="-9 -9 18 18" aria-hidden="true" focusable="false">
  <path fill="currentColor" d={fill[mode]} />
  {mode !== "dark" && <path fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" d={rays} />}
</svg>
