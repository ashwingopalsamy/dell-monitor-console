---
// The icon's dial as inline vector. `id` keeps the gradient and glow unique when it is drawn twice; without `glow`
// the disk is flat, which is all the 26px version in the header needs.
import { rays, lit, DISK } from "../dial";
interface Props {
  level?: number;
  id?: string;
  glow?: boolean;
  class?: string;
}
const { level = 75, id = "dial", glow = false, class: cls = "" } = Astro.props;
const on = lit(level);
---
<svg class:list={["dial", cls]} viewBox="9 9 82 82" style={`--l:${level / 100}`} aria-hidden="true" focusable="false">
  {glow && (
    <defs>
      <filter id={`${id}-blur`} x="-80%" y="-80%" width="260%" height="260%"><feGaussianBlur stdDeviation="3.2" /></filter>
      <linearGradient id={`${id}-disk`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff" /><stop offset="1" stop-color="#d6d6d6" /></linearGradient>
    </defs>
  )}
  {rays.map((r, i) => (
    <line class={i < on ? "ray on" : "ray"} x1={r.x1} y1={r.y1} x2={r.x2} y2={r.y2} stroke-width={r.width} stroke-linecap="round" />
  ))}
  {glow && <circle class="halo" cx="50" cy="50" r={DISK} filter={`url(#${id}-blur)`} />}
  <circle class="disk" cx="50" cy="50" r={DISK} fill={glow ? `url(#${id}-disk)` : "#f2f2f2"} />
</svg>
