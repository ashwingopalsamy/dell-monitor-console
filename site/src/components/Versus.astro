---
// The case as one picture. For each measure a line runs from zero to Dell's figure; Dell's app is the grey dot at its
// end, this app is the bright dot where its figure falls on the same line. The shorter the walk from the left, the
// better, and the gap is the saving. Plain numbers sit on the dots; the words on the right say it in two or three.
import { facts } from "../lib";
const f = facts as any;
const mid = (r: number[]) => (r[0] + r[1]) / 2;
const x = (k: string) => Math.min(1, mid(f[k].oursRange) / mid(f[k].theirsRange));
const times = (n: number) => `${n >= 10 ? Math.round(n) : Math.round(n * 10) / 10}×`;
const wakeLo = Math.round(f.wakeups.theirsRange[0] / mid(f.wakeups.oursRange));
const wakeHi = Math.round(f.wakeups.theirsRange[1] / mid(f.wakeups.oursRange));

const rows = [
  { label: "Installed size", us: f.size.ours, them: f.size.theirs, x: x("size"), says: f.size.ratio },
  { label: "Memory, idle", us: f.memory.ours, them: f.memory.theirs, x: x("memory"), says: `${times(mid(f.memory.theirsRange) / mid(f.memory.oursRange))} less` },
  { label: "CPU, idle", us: f.cpu.ours, them: f.cpu.theirs, x: 0, says: "None" },
  { label: "Wakeups a minute, idle", us: f.wakeups.ours, them: f.wakeups.theirs, x: x("wakeups"), says: `${wakeLo}–${wakeHi}× fewer` },
  { label: "Privacy permissions", us: "0", them: String(f.permissions.theirs.length), x: 0, says: `${f.permissions.theirs.length} fewer` },
];
// A label sits centred over its dot, unless the dot is near an end, where it hangs inward so it never leaves the line.
const edge = (v: number) => (v < 0.14 ? "start" : v > 0.86 ? "end" : "mid");
---
<div class="pl">
  <p class="pl-key" aria-hidden="true">
    <span><i class="us"></i>Dell Monitor Console</span>
    <span><i class="them"></i>Dell's app</span>
    <em>Closer to zero is better</em>
  </p>
  <ul class="pl-list">
    {rows.map((r) => (
      <li class="pl-row">
        <span class="pl-k">{r.label}</span>
        <div class="pl-plot" style={`--x:${r.x.toFixed(4)}`} role="img" aria-label={`${r.label}: this app ${r.us}, Dell's app ${r.them}`}>
          <span class="pl-axis"></span>
          <span class="pl-gap"></span>
          <i class="pl-dot us" data-edge={edge(r.x)}><b>{r.us}</b></i>
          <i class="pl-dot them" data-edge="end"><b>{r.them}</b></i>
        </div>
        <span class="pl-says">{r.says}</span>
      </li>
    ))}
  </ul>
  <p class="pl-foot">No network code. Nothing runs between adjustments. Dell's app has its own update channel built in.</p>
</div>
