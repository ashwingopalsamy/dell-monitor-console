---
// The sticky left column of a section: a label, the claim, and the line that backs it.
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  lede: string;
}
const { id, eyebrow, title, lede } = Astro.props;
---
<div class="side">
  <p class="eyebrow">{eyebrow}</p>
  <h2 id={`h-${id}`}>{title}</h2>
  <p class="lede">{lede}</p>
</div>
