{
  "name": "dell-monitor-console-site",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "dev": "npm run sync && astro dev",
    "build": "npm run sync && astro build && node scripts/post-build.mjs && node scripts/og.mjs && node scripts/icons.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "deploy": "npm run build && wrangler deploy",
    "dry-run": "npm run build && wrangler deploy --dry-run --outdir .wrangler/out"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@cloudflare/workers-types": "latest",
    "@fontsource/geist-sans": "^5.3.0",
    "@resvg/resvg-js": "2.6.2",
    "satori": "0.47.1",
    "typescript": "latest"
  }
}
